# Ignore OS junk; keep manuals and notes
.DS_Store
Thumbs.db
desktop.ini
*.tmp
~$*

# Do not commit secrets or member PII
*.env
*password*
*secret*
codeplugs/*-personal.*

_pdf-extract/
antennas/_extract/
*.mc4

# OEM / third-party manuals — keep local for drafting; do not publish in repo
radios/**/*.pdf
antennas/**/*.pdf
